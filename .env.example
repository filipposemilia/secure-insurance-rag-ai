# ==========================================
# Provider LLM: openai | azure | ollama | fake
# ==========================================
# "fake" non richiede rete né API key: risposte deterministiche, usato dai test.
LLM_PROVIDER=fake

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (scelta tipica enterprise: dati non usati per il training) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Ollama (100% locale, nessun dato esce dal perimetro) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==========================================
# Parametri RAG
# ==========================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVER_K=4
LLM_TEMPERATURE=0

# ==========================================
# Vault dei dati personali (pseudonimizzazione reversibile)
# ==========================================
# Senza chiave il vault NON viene scritto e il ripristino resta spento: il masking è irreversibile,
# che è il comportamento più prudente e il predefinito. Con la chiave, i ruoli elencati in
# UNMASK_ROLES vedono i valori reali al posto dei segnaposto, ripristinati solo a schermo e mai
# nel testo inviato al modello.
#
# Richiede la dipendenza opzionale:  uv pip install -e ".[vault]"
# Genera una chiave:
#   .venv/bin/python -c "from secure_rag.security.vault import genera_chiave; print(genera_chiave())"
PII_VAULT_KEY=
UNMASK_ROLES=management

# ==========================================
# Anonimizzazione livello 2: NER su testo libero
# ==========================================
# Le regex vedono ciò che ha una forma (codice fiscale, IBAN, targa). Non vedono un nome in mezzo a
# una frase — "il testimone Andrea Gallo ha dichiarato" — e nessun pattern potrà mai vederlo.
# Il livello 2 aggiunge Microsoft Presidio con un NER italiano: si affianca alle regex, non le
# sostituisce, perché sui formati rigidi il livello 1 è deterministico e testato.
#
# In produzione è ATTIVO: il modello sta nell'immagine Docker e docker-compose.yml imposta
# PII_NER_ENABLED=true. Qui il default è false perché in un'installazione da sorgente il modello
# pesa ~540 MB e la demo offline deve restare installabile in un minuto.
#
# Con il flag attivo ma la libreria o il modello assenti, il sistema torna alle sole regex
# DICHIARANDOLO — nell'esito dell'ingest e nella scheda Sicurezza — invece di far credere di aver
# mascherato di più. Il modello non viene mai scaricato automaticamente.
#
# Richiede le dipendenze opzionali:
#   uv pip install -e ".[presidio]"
#   .venv/bin/python -m spacy download it_core_news_lg     # ~540 MB, ~870 MB di RAM a regime
#
# Cambiare questo flag impone un nuovo `secure-rag ingest`, e il sistema se ne accorge da sé:
# l'indice porta una marca con i livelli usati per costruirlo e viene rifatto se non coincidono.
PII_NER_ENABLED=false
PII_NER_MODEL=it_core_news_lg
# Entità nel vocabolario di Presidio. LOCATION e ORGANIZATION mascherano anche il foro competente e
# le ragioni sociali nelle clausole, cioè testo contrattuale che il modello deve poter leggere.
PII_NER_ENTITIES=PERSON
# Soglia in ingresso: mascherare di troppo costa un segnaposto in più.
PII_NER_THRESHOLD=0.6
# Soglia in uscita, più severa: qui un falso positivo sopprime una risposta già pagata in token.
PII_NER_DETECT_THRESHOLD=0.85

# ==========================================
# Istanza pubblica
# ==========================================
# true = vetrina raggiungibile da chiunque: spariscono dall'interfaccia i controlli da
# amministratore (scelta del modello, reindicizzazione). La reindicizzazione costa embedding e
# non è coperta dai limiti di frequenza, che valgono per le domande.
PUBLIC_MODE=false

# ==========================================
# Limiti di frequenza (mitigazione LLM04)
# ==========================================
# Servono quando l'istanza è esposta in rete con una API key a carico di chi la pubblica.
# In locale restano disattivati.
#
# Superata la quota per visitatore, la richiesta viene rifiutata.
# Superato il tetto giornaliero, la demo NON si blocca: risponde con il motore deterministico
# offline, così il link resta navigabile e la spesa ha un massimo garantito.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_IP_HOUR=10
RATE_LIMIT_GLOBAL_DAY=300

# ==========================================
# Observability (LangSmith) — opzionale
# ==========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=secure-insurance-rag
